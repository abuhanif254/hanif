{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanif",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hanif"
    }
  ],
  "observability": {
    "enabled": true
  }
}

# ==============================================================================
# Environment Configuration Template
# Copy this file to .env.local and fill in production or staging credentials.
# ==============================================================================

# 1. Canonical Site URL (Used for Sitemap, Robots, Canonical URLs & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://abuhanifmia.com

# 2. Supabase Public Client Credentials (Client-side reads & public subscriptions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 3. Supabase Privileged Service Role Key (Server-Only API & Admin Mutations)
# Bypasses RLS for secure server-side mutations in /api/admin/* and /api/inquiries
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Admin Authentication & Session Cryptography
# Secret key used to sign HMAC-SHA256 session tokens for the /admin portal
ADMIN_SECRET_KEY=your-secure-admin-passcode-or-random-secret
ADMIN_TOTP_SECRET=your-optional-totp-base32-secret

# 5. Security Alerts & Discord/Slack Webhooks
# Dispatches high-priority alerts on brute-force attempts, bot blocks, or orders
SECURITY_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-alert-webhook
